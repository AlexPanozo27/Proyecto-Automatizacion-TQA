# Copie este archivo como  .env  en la carpeta del proyecto (no se sube a GitHub) y ajuste los valores.

# --- Sistema bajo prueba: SIBIO-RFID ---
SIBIO_URL=http://127.0.0.1:5000
SIBIO_ADMIN=admin
SIBIO_ADMIN_CLAVE=CAMBIAR_POR_LA_CLAVE_DEMO
SIBIO_OPERADOR=jperez
SIBIO_OPERADOR_CLAVE=CAMBIAR_POR_LA_CLAVE_DEMO
SIBIO_SUPERVISOR=agutierrez
SIBIO_SUPERVISOR_CLAVE=CAMBIAR_POR_LA_CLAVE_DEMO
# Solo si el administrador de pruebas tiene la verificación en dos pasos (2FA) vinculada en SIBIO:
# el secreto en base32 que muestra SIBIO al vincular la app autenticadora. Vacío si no tiene 2FA.
SIBIO_ADMIN_TOTP=
# Carpeta del repositorio sibio-rfid (Jarvis lee su README y su documentación). Vacío = la carpeta de arriba.
SIBIO_DOCS_DIR=

# --- Correo (Gmail con "contraseña de aplicación"; puede usar la misma que SIBIO) ---
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_NOMBRE=QA Lab SIBIO-RFID

# --- Web de la plataforma ---
QA_PUERTO=8080
QA_HOST=127.0.0.1           # 127.0.0.1 = solo esta computadora
QA_VER_NAVEGADOR=1          # 1 = se abre Chrome y se ve cómo hace las pruebas solo (demo); 0 = oculto, más rápido
QA_LENTO_MS=250             # pausa entre acciones cuando el navegador es visible
QA_PRESENTACION_MS=450      # pausa entre acciones en modo Presentación (se elige en la web, paso 4)

# --- Navegador ---
# CHROMIUM_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe   # opcional: usar Edge/Chrome instalado en vez del Chromium de Playwright
SELENIUM_NAVEGADOR=edge      # complemento Selenium: edge | chrome
SELENIUM_OCULTO=0            # 1 = Selenium sin ventana

# --- Pruebas no funcionales ---
QA_PERF_USUARIOS=10
QA_PERF_PETICIONES=10
QA_PERF_P95_MS=800
QA_ESTRES_USUARIOS=50
QA_ESTRES_PETICIONES=10
QA_SOAK_SEGUNDOS=30
QA_SOAK_USUARIOS=5

# --- Asistente de IA (gratis con Gemini: https://aistudio.google.com → Get API key) ---
IA_PROVEEDOR=gemini          # gemini | claude | simulado (simulado = respuestas fijas, sin clave)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3-flash-preview
GEMINI_MODELO_RESPALDO=gemini-flash-lite-latest   # responde si el principal tarda o está saturado
IA_ESPERA_S=40               # segundos que se espera al modelo principal
JARVIS_ESPERA_S=15           # Jarvis: segundos antes de pasar al modelo de respaldo (piensa en modo "low")
# ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-sonnet-5-5
